# === Datenbank ===
DATABASE_URL="file:./dev.db"

# === NextAuth ===
# Erzeugen mit: npx auth secret   (oder: openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3000"

# === Discord OAuth App (https://discord.com/developers/applications) ===
# Redirect-URI in der Discord-App eintragen: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID="CHANGE_ME"
AUTH_DISCORD_SECRET="CHANGE_ME"

# Die Discord-Server-ID (Guild-ID) des eigenen "OP - LeihCenter"-Discord-
# Servers (NICHT der offizielle OPSucht-Server!). Dort werden die Rollen
# Kunde LeihCenter / Aufsichtsperson / Owner vergeben. Rechtsklick auf den
# Server in Discord -> "Server-ID kopieren" (Entwicklermodus muss dafür in
# den Discord-Einstellungen unter Erweitert aktiviert sein).
DISCORD_GUILD_ID="CHANGE_ME"

# Rollen-IDs, die Zugriff gewähren. Kommagetrennt bei mehreren IDs pro Stufe.
DISCORD_ROLE_KUNDE="CHANGE_ME"
DISCORD_ROLE_AUFSICHT="CHANGE_ME"
DISCORD_ROLE_OWNER="CHANGE_ME"

# Nur fuer die Team-Anzeige auf der Startseite (keine App-Berechtigung).
DISCORD_ROLE_DEVELOPER_LEITUNG=""
DISCORD_ROLE_DEVELOPER=""

# Wenn "true": Login-Rollenprüfung wird übersprungen und jeder eingeloggte
# Discord-Account bekommt automatisch die Rolle aus DEV_FAKE_ROLE.
# NUR für lokale Entwicklung, solange die echte Discord-App/Rollen-IDs fehlen!
DEV_BYPASS_ROLE_CHECK="true"
DEV_FAKE_ROLE="OWNER"

# === Discord Bot ===
# Wird für zwei Dinge genutzt: (1) zuverlässige Rollenprüfung beim Login
# per GET /guilds/{guild}/members/{user} (siehe src/lib/discord.ts), sobald
# DISCORD_GUILD_ID gesetzt ist, und (2) später für das Ausleihen direkt im
# Discord-Channel. Der Bot muss dem "OP - LeihCenter"-Discord-Server
# beigetreten sein (nicht dem offiziellen OPSucht-Server).
DISCORD_BOT_TOKEN=""

# "Verify Key" der Discord-App (General Information -> Public Key), fuer die
# Signaturpruefung eingehender Interactions (Slash-Befehle/Buttons).
DISCORD_PUBLIC_KEY=""

# === Item-Preisquelle ===
# Externe Seite, aus der Owner Items inkl. Bild und Marktwert suchen und
# übernehmen können (siehe src/lib/priceSource.ts). Nur ändern, falls sich
# die URL der Datenbank ändert.
PRICE_SOURCE_URL="https://btc-clan.xyz/op-items"

# Kanal, in den JEDE geloggte Aktion (Audit-Log) zusätzlich gespiegelt wird
# (siehe src/lib/audit.ts). Leer lassen, um die Discord-Spiegelung abzuschalten.
DISCORD_LOG_CHANNEL_ID=""

# Kanal, in dem Business-Card-Aktivität (Überweisungen) gepostet wird -
# wird auf eingehende Zahlungen durchsucht (siehe src/lib/payments.ts).
DISCORD_PAYMENTS_CHANNEL_ID=""

# Kanal für Abo-Ablauf-Erinnerungen mit Verlängern-Buttons (siehe src/lib/subscriptions.ts).
DISCORD_SUBSCRIPTION_CHANNEL_ID=""

# Schuetzt /api/cron/loan-reminders (30/5-Min.-Erinnerungen, Ausleih-Sperren)
# vor Missbrauch. Erzeugen mit: openssl rand -hex 24
# Muss per System-Crontab jede Minute aufgerufen werden, z.B.:
# * * * * * curl -s "https://DEINE-DOMAIN/api/cron/loan-reminders?secret=DEIN_SECRET" > /dev/null
CRON_SECRET="CHANGE_ME"

# Kanal fuer das Wortkettenspiel (siehe src/lib/wordChain.ts). Braucht das
# privilegierte "Message Content Intent" im Discord Developer Portal unter
# Bot -> Privileged Gateway Intents (dort manuell aktivieren, geht nicht per API).
DISCORD_WORTKETTEN_CHANNEL_ID=""
