generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite kennt keine nativen Enums. Die erlaubten Werte werden stattdessen
// als String gespeichert und in src/lib/constants.ts als TS-Konstanten
// gepflegt (Role, MemberStatus, LoanStatus, LoanChannel, PriceStatus).

// Dauerhaftes Mitglieder-Archiv. Wird angelegt, sobald jemand erstmals eine
// LeihCenter-Rolle in Discord erhält, und bleibt auch nach Ausschluss/Bann
// durchsuchbar erhalten.
model Member {
  id             String   @id @default(cuid())
  discordId      String   @unique
  username       String
  displayName    String
  minecraftName  String
  avatarUrl      String?
  role           String   @default("KUNDE")
  status         String   @default("ACTIVE")
  // Zufaellig vergebene, eindeutige Kundennummer - wird als Verwendungszweck
  // ("Verleih <Kundennummer>") bei Business-Card-Ueberweisungen genutzt, um
  // Zahlungen zuverlaessig einem Mitglied zuzuordnen (siehe src/lib/payments.ts).
  customerNumber String?  @unique

  monthlyFee     Int      @default(5000000)
  feePaidUntil   DateTime?
  subscriptionPlan String?
  // Wann zuletzt eine Ablauf-Erinnerung fuer die AKTUELLE Laufzeit (feePaidUntil)
  // in den Discord-Abo-Kanal gepostet wurde. Verhindert Spam bei wiederholten
  // Checks; wird bei jeder Verlaengerung implizit ungueltig (neues feePaidUntil).
  subscriptionReminderSentAt DateTime?

  joinedAt       DateTime @default(now())
  revokedAt      DateTime?
  revokedReason  String?
  bannedAt       DateTime?
  bannedReason   String?

  // Temporaere Ausleih-Sperre (z.B. nach mehr als 15 Min. Ueberziehung einer
  // Ausleihe) - unabhaengig vom "status"-Feld: die Person bleibt aktives
  // Mitglied, darf in diesem Zeitraum aber nichts Neues ausleihen.
  borrowSuspendedUntil  DateTime?
  borrowSuspendedReason String?

  // Abo-Pause (auf Antrag per Support-Ticket): waehrend pausedAt gesetzt ist,
  // bleibt das Mitglied aktiv, darf aber nichts ausleihen und zahlt fuer
  // diese Zeit nicht - die pausierten Tage werden beim Fortsetzen an
  // feePaidUntil drangehaengt (siehe resumeMemberCore in subscriptions.ts).
  pausedAt       DateTime?
  pauseReason    String?
  pausedById     String?
  pauseTicketId  String?

  // Aus der Bewerbung uebernommen (siehe MembershipApplication).
  age            Int?
  playHours      Int?

  // Verifizierung des Minecraft-Accounts (siehe src/lib/verification.ts):
  // minecraftUuid kommt aus der Mojang-API und bleibt bei Namensaenderungen
  // gleich - dadurch faellt eine Umbenennung beim Abgleich automatisch auf.
  // Ohne verifiedAt darf ein Kunde nichts ausleihen.
  minecraftUuid  String?
  verifiedAt     DateTime?
  verifiedById   String?

  // Guthaben in $ (1 ₵ = 1 $): Business-Card-Zahlungen werden hier
  // gutgeschrieben (siehe creditPaymentToBalance in src/lib/payments.ts),
  // nicht direkt einem Abo zugeordnet. Owner "buchen" davon ein Abo-Paket ab
  // (setSubscriptionPlanCore in src/lib/subscriptions.ts). Es gibt keine
  // Auszahlung/Rueckueberweisung an den Kunden - Guthaben bleibt dauerhaft
  // hinterlegt und wird nur bei Bann (Regelverstoss) geloescht.
  balance        Int      @default(0)

  // "Sperren" (Owner) = Abo laeuft nur noch bis feePaidUntil aus, keine
  // weitere Verlaengerung moeglich - anders als BANNED/REVOKED (sofortiger
  // Ausschluss). lockNoticeSentAt haelt fest, wann die Dauerauftrag-Warnung
  // verschickt wurde (fuer die 24h-Regel, siehe isRefundEligible in
  // src/lib/subscriptions.ts).
  lockedAt         DateTime?
  lockReason       String?
  lockedById       String?
  lockNoticeSentAt DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loans          Loan[]
  planChangeRequests PlanChangeRequest[]
  notesAbout     MemberNote[] @relation("NotesAboutMember")
  notesAuthored  MemberNote[] @relation("NotesByAuthor")
  auditAsActor   AuditLog[]   @relation("AuditActor")
  auditAsTarget  AuditLog[]   @relation("AuditTarget")
  payments       Payment[]
  sanctions      Sanction[]   @relation("SanctionsAboutMember")
  sanctionsIssued Sanction[]  @relation("SanctionsByIssuer")
  review         Review?

  @@index([status])
  @@index([role])
}

// Eingetragene Sanktion gegen ein Mitglied (Verwarnung wegen ueberschrittener
// Leihdauer, zu vieler Items etc.). Rein dokumentarisch - die technische
// Durchsetzung (Ausleih-Sperre, Bann) laeuft weiterhin ueber die Felder am
// Member selbst; hier steht der nachvollziehbare Verlauf.
model Sanction {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation("SanctionsAboutMember", fields: [memberId], references: [id], onDelete: Cascade)
  type       String   // VERWARNUNG | AUSLEIHSPERRE | SONSTIGES
  reason     String
  issuedById String?
  issuedBy   Member?  @relation("SanctionsByIssuer", fields: [issuedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([memberId])
}

// Kundenbewertung des LeihCenters - eine pro Mitglied, jederzeit
// ueberschreibbar (deshalb memberId eindeutig statt einer Historie).
model Review {
  id        String   @id @default(cuid())
  memberId  String   @unique
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5 Sterne
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Erkannte Zahlungen aus dem Discord-Zahlungskanal (Business-Card-System
// eines anderen Bots). Wird per Discord-Nachrichten-ID dedupliziert, damit
// derselbe Eingang nie doppelt verarbeitet wird. Betrag steht in der
// Business-Card-Waehrung (Cedis, ₵) - das ist eine andere Skala als unsere
// $-Abo-Preise, deshalb wird hier NIE automatisch ein Abo-Plan zugeordnet,
// sondern von Aufsicht/Owner manuell bestaetigt.
model Payment {
  id               String   @id @default(cuid())
  discordMessageId String   @unique
  amount           Int
  discordUsername  String
  reason           String?
  receivedAt       DateTime
  status           String   @default("PENDING") // PENDING | APPLIED | DONATED | IGNORED
  memberId         String?
  member           Member?  @relation(fields: [memberId], references: [id])
  appliedPlanId    String?

  createdAt        DateTime @default(now())

  @@index([status])
}

model Item {
  id             String    @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  sourceUrl      String?
  sourceKey      String?
  averagePrice   Int?
  priceStatus    String    @default("MANUAL")
  priceCheckedAt DateTime?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quantityTotal  Int       @default(1)
  createdById    String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  loans          Loan[]

  @@index([categoryId])
  @@index([sourceKey])
}

// Item-Kategorien, vom Owner frei anlegbar (z.B. Werkzeug, Ruestung, Deko).
// Wird zum Einsortieren und Filtern/Suchen im Item-Katalog genutzt.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  items     Item[]
}

model Loan {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  channel     String    @default("WEB")
  status      String    @default("ACTIVE")

  borrowedAt  DateTime  @default(now())
  // Feste 2h-Ausleihfrist ab borrowedAt, wird beim Ausleihen automatisch gesetzt.
  dueAt       DateTime?
  returnedAt  DateTime?
  notes       String?

  // Welche Erinnerungsstufe fuer diese Ausleihe zuletzt verschickt wurde -
  // verhindert doppelte Discord-DMs bei jedem Cron-Durchlauf. Reihenfolge:
  // NONE -> THIRTY (30 Min. vorher) -> FIVE (5 Min. vorher) -> OVERDUE
  // (Frist abgelaufen) -> SUSPENDED (mehr als 15 Min. ueberzogen, Sperre verhaengt).
  reminderStage String @default("NONE")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([memberId])
  @@index([itemId])
  @@index([status])
}

model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation("NotesAboutMember", fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String
  author    Member   @relation("NotesByAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([memberId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     Member?  @relation("AuditActor", fields: [actorId], references: [id])
  targetId  String?
  target    Member?  @relation("AuditTarget", fields: [targetId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// Wortkettenspiel in einem festen Discord-Kanal: ein Wort reinschreiben, das
// mit dem letzten Buchstaben des vorherigen Wortes beginnt. Ein Spiel pro
// Kanal (channelId eindeutig); "/wortketten-reset" loescht per Cascade alle
// Eintraege und die Kette beginnt beim naechsten gueltigen Wort neu.
model WordChainGame {
  id        String   @id @default(cuid())
  channelId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   WordChainEntry[]
}

// turnIndex zaehlt fortlaufend pro Spiel hoch (1, 2, 3, ...) - macht den
// "mind. 5 Woerter Abstand bis zur Wiederverwendung"-Check zu einer simplen
// Ganzzahl-Differenz statt einer Zeitstempel-Zaehlung.
model WordChainEntry {
  id        String        @id @default(cuid())
  gameId    String
  game      WordChainGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  turnIndex Int
  word      String
  wordLower String
  discordId String
  createdAt DateTime      @default(now())

  @@index([gameId, wordLower])
  @@index([gameId, turnIndex])
}

// Ein Discord-Server, auf dem der Ausleih-Bot ein sich selbst
// aktualisierendes Item-Panel in einem bestimmten Kanal pflegt. Der Bot muss
// dem Server zusaetzlich manuell per Invite-Link hinzugefuegt werden - das
// kann nicht per API ausgeloest werden.
model BotDeployment {
  id              String    @id @default(cuid())
  guildId         String    @unique
  guildName       String?
  channelId       String
  borrowRoleId    String
  panelMessageId  String?

  // Optionaler zweiter Kanal, in dem nur die aktuell ausgeliehenen Items
  // mit Discord-nativem Live-Timestamp (<t:...:R>) angezeigt werden.
  statusChannelId String?
  statusMessageId String?

  // Ticket-System: Kategorie-Kanal, unter dem private Ticket-Kanaele
  // entstehen, sowie das Panel ("Support"/"Bewerbung"-Buttons) in einem
  // eigenen Kanal. ticketsVisibleToCustomers steuert, ob die Kunde-Rolle den
  // Panel-Kanal ueberhaupt sehen darf (Owner schaltet das erst frei, wenn
  // alles fertig eingerichtet ist). Claim-Rollen sind kommagetrennte
  // Discord-Rollen-IDs, analog zu roleIdsFromEnv.
  ticketCategoryId          String?
  ticketPanelChannelId      String?
  ticketPanelMessageId      String?
  ticketsVisibleToCustomers Boolean   @default(false)
  supportClaimRoleIds       String?
  bewerbungClaimRoleIds     String?
  // Staff-only Kanal mit einer Claim-Button-Nachricht pro neuem Ticket -
  // getrennt vom privaten Ticket-Kanal selbst (siehe Ticket.queueMessageId).
  ticketQueueChannelId      String?

  active          Boolean   @default(true)
  createdById     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Bewerbung um Kunde zu werden - eingereicht per Website oder Discord
// (/bewerben). Wird vom Owner geprueft (siehe Plan: nur Owner darf final
// annehmen/ablehnen) und bei Annahme in einen aktiven Member ueberfuehrt.
model MembershipApplication {
  id               String   @id @default(cuid())
  discordId        String
  username         String
  displayName      String
  avatarUrl        String?

  reason           String
  declaredNetWorth Int
  requestedPlanId  String
  source           String   // WEB | DISCORD

  // Werden bei Annahme auf den Member uebernommen (siehe approveApplicationCore).
  minecraftName    String
  age              Int
  playHours        Int

  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason  String?
  reviewedById     String?
  reviewedAt       DateTime?
  memberId         String?
  ticketId         String?  @unique

  createdAt        DateTime @default(now())

  items            MembershipApplicationItem[]

  @@index([discordId])
  @@index([status])
}

// Einzelnes vom Bewerber angegebenes Item als Vermoegensnachweis - entweder
// aus dem btc-clan-Preiskatalog gewaehlt (sourceKey gesetzt) oder frei
// eingetragen (nur name/declaredPrice).
model MembershipApplicationItem {
  id            String  @id @default(cuid())
  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceKey     String?
  name          String
  declaredPrice Int
  quantity      Int     @default(1)
}

// Wer hier per discordId eingetragen ist, kann sich nicht bewerben.
// expiresAt = null bedeutet dauerhafte Sperre (rote Liste); mit Datum ist es
// eine befristete Aufnahmesperre - danach ist eine erneute Bewerbung wieder
// moeglich, ohne dass der Eintrag manuell geloescht werden muss.
model ApplicationBlock {
  id          String   @id @default(cuid())
  discordId   String   @unique
  reason      String
  blockedById String?
  blockedAt   DateTime @default(now())
  expiresAt   DateTime?
}

// Support- oder Bewerbungs-Ticket. Der eigentliche Verlauf findet in einem
// privaten Discord-Kanal statt (siehe tickets.ts/discord.ts) - die
// Website zeigt nur Status + Link zum Kanal, kein Nachrichten-Sync.
model Ticket {
  id                 String    @id @default(cuid())
  category           String    // SUPPORT | BEWERBUNG
  subject            String
  status             String    @default("OPEN") // OPEN | CLAIMED | CLOSED

  applicantDiscordId String
  memberId           String?
  applicationId      String?   @unique

  claimedById        String?
  claimedAt          DateTime?

  discordGuildId     String
  discordChannelId   String?

  closedById         String?
  closedAt           DateTime?

  // Nachricht in der Claim-Warteschlange (BotDeployment.ticketQueueChannelId)
  // - wird beim Claim/Close editiert (Button entfernt, "von X uebernommen").
  queueMessageId     String?

  // Beim Schliessen aus dem Discord-Thread gesicherter Gespraechsverlauf -
  // dient als Nachweis, falls spaeter strittig ist, was zugesagt wurde.
  // Threads koennen archiviert/geloescht werden, die Kopie hier bleibt.
  transcript         String?

  createdAt          DateTime  @default(now())

  @@index([status])
  @@index([memberId])
}

// Kunde beantragt ein anderes Abo-Paket - muss vom Owner genehmigt werden
// (siehe requestPlanChangeCore/approvePlanChangeCore). Genehmigung aendert
// nur subscriptionPlan/monthlyFee fuer die naechste Verlaengerung, die
// aktuelle Laufzeit (feePaidUntil) bleibt unangetastet.
model PlanChangeRequest {
  id              String    @id @default(cuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requestedPlanId String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([memberId])
  @@index([status])
}
